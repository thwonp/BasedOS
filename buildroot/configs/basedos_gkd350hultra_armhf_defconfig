# BasedOS's 32-bit (armhf) userland for the GKD 350H Ultra, Buildroot 2025.02 LTS: the libraries
# PortMaster's 32-bit ports run on (about 200 of its ports have no 64-bit build). The kernel runs
# AArch32 programs; nothing of BasedOS's own is 32-bit. tools/wsl/build-rootfs.sh takes what
# manifest/base32.list names from this root into the system layer's /usr/lib32, as stock (ROCKNIX)
# lays it out. BasedOS's own SDL2 and librga are built for armhf by tools/sdl2 with this
# toolchain. See docs/lib32.md.

BR2_arm=y
BR2_cortex_a72_a53=y
BR2_ARM_EABIHF=y
BR2_ARM_FPU_NEON_FP_ARMV8=y
BR2_DL_DIR="$(HOME)/basedos-br-dl"

# Toolchain: as the 64-bit root's (glibc 2.41, GCC 14, the stock kernel's 6.1 headers). The loader
# finds libraries in /usr/lib32 (buildroot/external.mk); its PT_INTERP stays
# /lib/ld-linux-armhf.so.3, which is what armhf programs ask for.
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_6_1=y
BR2_GCC_VERSION_14_X=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_GCC_ENABLE_OPENMP=y

# Only a root to take libraries from.
BR2_ROOTFS_MERGED_USR=y
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_PACKAGE_BUSYBOX is not set
# BR2_TARGET_ROOTFS_TAR is not set

# libudev.so.1, as in the 64-bit root (SDL builds load it).
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_EUDEV=y

# What the closed 32-bit Mali driver needs (it is the vendor layer's, from stock's /usr/lib32).
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_LIBDRM=y

BR2_PACKAGE_ALSA_LIB=y

# SDL2's add-ons (stock's /usr/lib32 has them; older 32-bit ports use them from the system).
# Buildroot's SDL2 is only linked against: BasedOS's own (tools/sdl2, armhf) is the one installed.
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_IMAGE=y
BR2_PACKAGE_SDL2_TTF=y
BR2_PACKAGE_SDL2_MIXER=y
BR2_PACKAGE_SDL2_NET=y

# The 64-bit root's libraries, in 32 bits.
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBOPENSSL=y
BR2_PACKAGE_EXPAT=y
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_LIBGLIB2=y
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_NCURSES_WCHAR=y
BR2_PACKAGE_LIBSNDFILE=y
BR2_PACKAGE_FLAC=y
BR2_PACKAGE_LIBOGG=y
BR2_PACKAGE_LIBVORBIS=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_LIBUUID=y
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_BZIP2=y
BR2_PACKAGE_LIBPNG=y
# No LuaJIT: Buildroot builds 32-bit LuaJIT only with a 32-bit host compiler (gcc-multilib).
BR2_PACKAGE_ENET=y
BR2_PACKAGE_JSON_C=y
BR2_PACKAGE_LIBEVDEV=y
BR2_PACKAGE_SPEEXDSP=y
BR2_PACKAGE_LIBUSB=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_FLUIDSYNTH=y
BR2_PACKAGE_HARFBUZZ=y
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_JPEG_TURBO=y
BR2_PACKAGE_TIFF=y

# Audio that 32-bit ports load from the system (stock's /usr/lib32 has them).
BR2_PACKAGE_OPENAL=y
BR2_PACKAGE_MPG123=y
BR2_PACKAGE_LIBMODPLUG=y
# The sound server's client library: 32-bit programs can't load PipeWire's 64-bit ALSA plugin
# (ALSA's "default" is PipeWire's), so they reach PipeWire's PulseAudio server instead. OpenAL
# gets its PulseAudio backend from this (openal.mk), and BasedOS's 32-bit SDL2 loads it too
# (tools/sdl2). Only libpulse goes to /usr/lib32 (manifest/base32.list).
BR2_PACKAGE_PULSEAUDIO=y

# What else stock's /usr/lib32 has that ports may load (tools/lib32-gaps.py, 2026-11-19), where
# Buildroot has it. Not here: libxml2.so.2 (Buildroot's is 2.15, libxml2.so.16), libxmp and
# SDL2_sound (no Buildroot package), libepoxy and glfw (need desktop GL or a windowing system).
BR2_PACKAGE_SDL2_GFX=y
BR2_PACKAGE_LIBTOOL=y
BR2_PACKAGE_OPUSFILE=y
BR2_PACKAGE_PIXMAN=y
BR2_PACKAGE_SPEEX=y
BR2_PACKAGE_TREMOR=y
BR2_PACKAGE_ZSTD=y

# What 32-bit ports load from the system and this lacked (docs/portmaster-libs.md, 2026-11-19).
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_LIBGPG_ERROR=y
BR2_PACKAGE_LAME=y
