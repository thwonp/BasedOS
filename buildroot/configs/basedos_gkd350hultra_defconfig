# BasedOS userland for the GKD 350H Ultra (RK3576: Cortex-A72 + A53), Buildroot 2025.02 LTS.
# Buildroot only builds a root here; tools/wsl/build-rootfs.sh takes the files manifest/base.list
# names from it into the system layer. BasedOS's init, BusyBox, SDL2, librga and bash come from
# BasedOS's own builds, not from this. See docs/vendor-minimal.md.

BR2_aarch64=y
BR2_cortex_a72_a53=y
BR2_DL_DIR="$(HOME)/basedos-br-dl"

# Toolchain: built here, glibc (2.41 in this release: newer than stock's 2.40, which ports built
# for ROCKNIX expect), GCC 14 (stock's libstdc++ is GCC 14's), headers of the stock kernel's 6.1.
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_KERNEL_HEADERS_6_1=y
BR2_GCC_VERSION_14_X=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_GCC_ENABLE_OPENMP=y
BR2_TOOLCHAIN_GLIBC_GCONV_LIBS_COPY=y
BR2_PACKAGE_GLIBC_UTILS=y

# No init, shell or images of Buildroot's: BasedOS has its own.
BR2_ROOTFS_MERGED_USR=y
BR2_INIT_NONE=y
BR2_SYSTEM_BIN_SH_NONE=y
# BR2_PACKAGE_BUSYBOX is not set
# BR2_TARGET_ROOTFS_TAR is not set

# libudev.so.1: spruce's RetroArch (ra64.universal) links it, and SDL builds load it. Buildroot's
# only libudev is eudev's, which wants eudev chosen for /dev; that only affects Buildroot's own
# root, which BasedOS doesn't use. BasedOS runs no udev daemon (as before, with stock's libudev).
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_EUDEV=y

# What the closed Mali drivers need.
BR2_PACKAGE_WAYLAND=y
BR2_PACKAGE_LIBDRM=y
BR2_PACKAGE_VULKAN_LOADER=y
# Its implicit layer that turns VK_KHR_display apps onto the portrait panel (package/basedos-vkrotate).
BR2_PACKAGE_BASEDOS_VKROTATE=y

# BasedOS's own services and tools (were stock's).
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_CLI=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_EVTEST=y
# mksquashfs for basedos-vendor: a device builds its own vendor layer from its stock image.
BR2_PACKAGE_SQUASHFS=y
BR2_PACKAGE_SQUASHFS_ZSTD=y
BR2_PACKAGE_SQUASHFS_LZ4=y

# SDL2 add-ons for spruce's display_text.elf. Buildroot's SDL2 is only linked against: BasedOS's
# own (tools/sdl2) is the one installed.
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_IMAGE=y
BR2_PACKAGE_SDL2_TTF=y

# What spruce's card binaries expect from the base (tools/needs-check.py).
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBOPENSSL=y
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_EXPAT=y
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_LIBGLIB2=y
BR2_PACKAGE_NCURSES=y
BR2_PACKAGE_NCURSES_WCHAR=y
BR2_PACKAGE_LIBSNDFILE=y
BR2_PACKAGE_FLAC=y
BR2_PACKAGE_FLAC13=y
BR2_PACKAGE_LIBOGG=y
BR2_PACKAGE_LIBVORBIS=y
BR2_PACKAGE_OPENAL=y
BR2_PACKAGE_SQLITE=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_LIBUUID=y
BR2_PACKAGE_ZLIB=y
BR2_PACKAGE_XZ=y
BR2_PACKAGE_BZIP2=y
BR2_PACKAGE_LIBPNG=y

# For PortMaster's ports (2026-11-19 list).
BR2_PACKAGE_LUAJIT_LIB=y
BR2_PACKAGE_ENET=y
BR2_PACKAGE_JSON_C=y
BR2_PACKAGE_LIBEVDEV=y
BR2_PACKAGE_SPEEXDSP=y
BR2_PACKAGE_LIBUSB=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_FLUIDSYNTH=y
BR2_PACKAGE_LIBXML2=y
BR2_PACKAGE_HARFBUZZ=y
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_JPEG_TURBO=y
BR2_PACKAGE_TIFF=y
# sdl12-compat (older SDL1 ports) is not in Buildroot 2025.02: to come as a BasedOS package.
BR2_PACKAGE_UTIL_LINUX_SCHEDUTILS=y
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_FILE=y
BR2_PACKAGE_ZSTD=y
# What spruce's own libraries for ports (spruce/flip/lib) expect from the base and BasedOS lacked
# (docs/portmaster-libs.md): libbsd for its libXdmcp and libICE (on its PulseAudio client chain,
# which ports' music libraries load), libtheora's encoder for its FFmpeg.
BR2_PACKAGE_LIBBSD=y
BR2_PACKAGE_LIBTHEORA=y

# Audio and Bluetooth for frontends that want a sound server (plorpOS): PipeWire with its
# PulseAudio server and ALSA plugin, WirePlumber (Lua 5.4: luajit-lib keeps ports' LuaJIT
# beside it), bluez5 with A2DP/AVRCP through PipeWire, the HCI attach tools, and pactl.
# Nothing starts them yet.
BR2_PACKAGE_PIPEWIRE=y
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LUA_5_4=y
BR2_PACKAGE_WIREPLUMBER=y
BR2_PACKAGE_SBC=y
BR2_PACKAGE_BLUEZ5_UTILS=y
BR2_PACKAGE_BLUEZ5_UTILS_CLIENT=y
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_AUDIO=y
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_HID=y
BR2_PACKAGE_PULSEAUDIO=y
