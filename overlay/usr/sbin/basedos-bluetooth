#!/bin/sh
# basedos-bluetooth start|stop|status: the Bluetooth radio and bluez's bluetoothd, for frontends
# that offer Bluetooth (headsets through basedos-pipewire, controllers). Not started at boot.
#
#   start   unblock the radio (rfkill), attach the chip to the kernel if it isn't already (hci0),
#           D-Bus's system bus (if not up), bluetoothd; bring hci0 up. Nothing if running.
#   stop    bluetoothd, the attach, block the radio; the bus unless basedos-pipewire still uses it.
#   status  exit 0 if bluetoothd runs.
#
# How the chip is attached is in /usr/share/basedos/bluetooth.conf. Pairings live on /data
# (/var/lib/bluetooth links there), so they survive restarts and updates.
. /usr/lib/basedos/functions
CONF=/usr/share/basedos/bluetooth.conf
PID=/run/basedos/bluetoothd.pid
ATT=/run/basedos/bt-attach.pid
OUT=/run/basedos/bluetooth.log
BT_UART="" BT_BAUD="" BT_ATTACH=""
[ -f $CONF ] && . $CONF

running() { [ -f $PID ] && kill -0 "$(cat $PID)" 2>/dev/null; }

# rfkill_set 0|1: unblock (0) or block (1) every Bluetooth radio, through sysfs (no rfkill tool).
rfkill_set() {
	for _r in /sys/class/rfkill/rfkill*; do
		[ "$(cat "$_r/type" 2>/dev/null)" = bluetooth ] && echo "$1" > "$_r/soft"
	done
}

case "$1" in
start)
	running && exit 0
	mkdir -p /run/basedos /data/bluetooth
	[ -e /var/lib/bluetooth ] || { mkdir -p /var/lib; ln -s /data/bluetooth /var/lib/bluetooth; }
	rfkill_set 0
	if [ ! -e /sys/class/bluetooth/hci0 ] && [ -z "$BT_ATTACH" ]; then
		log "no hci0, and $CONF names no attach for the chip"
		rfkill_set 1
		exit 1
	fi
	if [ ! -e /sys/class/bluetooth/hci0 ]; then
		# The attach program stays running for as long as the chip is attached.
		$BT_ATTACH >> $OUT 2>&1 &
		echo $! > $ATT
		_i=0
		while [ ! -e /sys/class/bluetooth/hci0 ] && [ $_i -lt 100 ]; do usleep 100000; _i=$((_i + 1)); done
	fi
	[ -e /sys/class/bluetooth/hci0 ] || { log "no hci0 after attach ($BT_ATTACH; see $OUT)"; stop_pidfile $ATT; rfkill_set 1; exit 1; }
	dbus_up || { stop_pidfile $ATT; rfkill_set 1; exit 1; }
	/usr/libexec/bluetooth/bluetoothd -n >> $OUT 2>&1 &
	echo $! > $PID
	hciconfig hci0 up 2>> $OUT
	log "Bluetooth started"
	;;
stop)
	running || [ -f $ATT ] || exit 0
	stop_pidfile $PID
	stop_pidfile $ATT
	rfkill_set 1
	dbus_down $PID
	log "Bluetooth stopped"
	;;
status)
	running
	;;
*)
	echo "usage: ${0##*/} start|stop|status" >&2
	exit 2
	;;
esac
