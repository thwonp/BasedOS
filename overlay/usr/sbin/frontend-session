#!/bin/sh
# Respawned by init. Finds the frontend on the card and execs it, with every
# /etc/baseos-release key in the environment. First match wins:
#   System/frontend            (NextUI-style binary, run through ld.so)
#   System/launch_frontend.sh
#   spruce/scripts/runtime.sh  (spruceOS)
#   .tmp_update/updater        (MinUI/NextUI updater)
# spruce comes before .tmp_update because spruce cards also carry a Miyoo
# .tmp_update for other devices.
#
# Boot keys: a button held while powering on picks this boot's action, from
# /data/boot-keys.conf or BasedOS's default (/usr/share/basedos/boot-keys.conf):
#   maintenance        no frontend; SSH and Wi-Fi only (default: Select)
#   frontend <entry>   start <entry> on the card instead of the first match above
#
# The screens that wait (no card; a card with no frontend; a frontend that keeps failing) watch
# the same map: a mapped button held for a second there does its maintenance or stock action,
# without a restart.
#
# Safeguards:
#   - A frontend that exits within 15 s, five times in a row, is not restarted again until
#     the next boot (no hot loop draining the battery and writing to the card). BasedOS's own
#     Wi-Fi and SSH come up then, as in maintenance mode, so it can be looked at.
# Wi-Fi and SSH are otherwise the frontend's: BasedOS only loads the Wi-Fi driver at boot.
export PATH=/usr/bin:/usr/sbin
. /usr/lib/basedos/functions
SD=/mnt/SDCARD
STATE=/run/basedos

# BasedOS's own Wi-Fi and SSH, when no frontend will provide them (once a boot).
basedos_network() {
	[ -f $STATE/basedos-network ] && return 0
	touch $STATE/basedos-network
	/etc/init.d/network up
	/etc/init.d/sshd
}

# now_cs: the uptime in hundredths of a second.
now_cs() { read -r _u _ < /proc/uptime; _s=${_u%.*} _f=${_u#*.}; echo $(( _s * 100 + 1$_f - 100 )); }

# waiting_screen: no card: what to do, and the buttons that work here (key_watch).
waiting_screen() {
	_hints=$(boot_key_hints maintenance stock)
	{
		echo "!NO SD CARD"
		echo "Insert your SD card."
		[ -n "$_hints" ] && echo "Or hold a labelled button."
		[ -n "$_hints" ] && echo "$_hints"
	} > "$SPLASH_INFO"
	say "Waiting for an SD card..." "no card in the slot (waiting for one)"
}

# key_watch: about a second of watching the boot-key map; a mapped button held for a second does
# its maintenance or stock action (the frontend action needs a card with it: not here). For the
# screens that wait (no card, no frontend on the card, a frontend that keeps failing).
_kw="" _kw_t=0
key_watch() {
	_end=$(( $(now_cs) + 100 ))
	while [ "$(now_cs)" -lt $_end ]; do
		set -- $(boot_key_action)
		if [ -z "${1:-}" ] || [ "$1 $2" != "$_kw" ]; then
			_kw=${1:+$1 $2} _kw_t=$(now_cs)
		elif [ $(( $(now_cs) - _kw_t )) -ge 100 ]; then
			case "$2" in
			maintenance)
				touch $STATE/maintenance
				log "$(button_label "$1") held while waiting: maintenance mode"
				exit 1 ;;
			stock)
				log "$(button_label "$1") held while waiting: stock for this boot"
				if basedos-boot stock-once --reboot; then while :; do sleep 3600; done; fi
				# It didn't: said, and the screen keeps watching (Select still works).
				say "Couldn't start stock. Restart to try again." "couldn't hand over to stock (basedos-boot stock-once failed)"
				_kw="" ;;
			esac
		fi
		usleep 100000
	done
}

# A frontend that keeps failing: stop, and bring up Wi-Fi and SSH so it can be looked at. The
# boot screen's buttons (maintenance, stock) still work.
stay_down() {
	say "$1" "${2:-$1}"
	basedos_network
	while :; do key_watch; done
}

# intermission_when_covered: the boot screen stays in the framebuffer, which the panel shows again
# whenever the frontend lets go of the display (between its menu and an app, say) until the
# frontend draws over it or clears it. In the background, once something else is on the panel
# (the frontend's first frame), redraw the framebuffer, out of sight, as "Intermission..." alone in
# the middle, so what shows through later looks meant. What's on the panel is read from the DRM
# state in debugfs (mounted for this only): opening the display device to ask would make this the
# display's owner while no program is. A frontend that draws on the framebuffer itself never
# changes what's shown, so its picture is never drawn over. Ends with the frontend.
intermission_when_covered() {
	# The boot logo is what should show through: left as it is.
	[ -f $STATE/boot-logo ] && return 0
	_dbg=$STATE/debugfs
	mkdir -p $_dbg
	grep -q " $_dbg debugfs " /proc/mounts || mount -t debugfs none $_dbg 2>/dev/null || return 0
	_st=$_dbg/dri/0/state
	# The framebuffer's ID: the one plane showing anything before the frontend starts.
	_fb=$(sed -n 's/^[[:space:]]*fb=\([1-9][0-9]*\)$/\1/p' $_st 2>/dev/null | head -n 1)
	if [ -z "$_fb" ]; then
		umount $_dbg 2>/dev/null
		return 0
	fi
	_session=$$
	( (
		while kill -0 $_session 2>/dev/null; do
			usleep 250000
			grep -q "^[[:space:]]*fb=$_fb\$" $_st && continue
			splash --centre "Intermission..."
			log "the frontend is on the panel: Intermission... behind it"
			break
		done
		umount $_dbg 2>/dev/null
	) </dev/null >/dev/null 2>&1 & )
}

# starting <screen text> <log text>: the boot logo while a frontend starts (boot_logo; drawn again
# only if a text screen has covered it since), else the text screen.
starting() {
	log "$2"
	[ -f $STATE/boot-logo ] || boot_logo || splash "$1"
}

# run_frontend <entry>: exec one of the card's frontends, the way its kind is started.
run_frontend() {
	case "$1" in
	System/frontend)
		starting "Starting frontend..." "starting System/frontend"
		intermission_when_covered
		exec /lib/ld-linux-aarch64.so.1 "$SD/System/frontend" > /tmp/frontend.log 2>&1 ;;
	spruce/scripts/runtime.sh)
		starting "Starting spruce..." "starting spruce"
		intermission_when_covered
		exec /bin/sh "$SD/$1" ;;
	*.sh|.tmp_update/updater)
		starting "Starting frontend..." "starting $1"
		intermission_when_covered
		exec /bin/sh "$SD/$1" ;;
	*)
		starting "Starting frontend..." "starting $1"
		intermission_when_covered
		exec "$SD/$1" ;;
	esac
}

# First session of this boot only: the boot keys (read once, a few ms; the choice holds for
# the whole boot, respawns included).
if [ ! -f $STATE/session-checked ]; then
	touch $STATE/session-checked
	act=$(boot_key_action)
	set -- $act
	case "$2" in
	"") ;;
	maintenance)
		touch $STATE/maintenance
		log "$(button_label "$1") held at boot: maintenance mode" ;;
	stock)
		log "$(button_label "$1") held at boot: stock for this boot"
		# reboot only asks init and returns 0: on success, wait for it here.
		basedos-boot stock-once --reboot ||
			stay_down "Couldn't start stock. Restart to try again." "couldn't hand over to stock (basedos-boot stock-once failed)"
		while :; do sleep 3600; done ;;
	frontend)
		if [ -n "$3" ]; then
			echo "$3" > $STATE/frontend-choice
			log "$(button_label "$1") held at boot: frontend $3"
		else
			log "$(button_label "$1") held at boot: 'frontend' without an entry in $(boot_keys_conf)"
		fi ;;
	*)
		log "$(button_label "$1") held at boot: unknown action '$2' in $(boot_keys_conf)" ;;
	esac
fi
if [ -f $STATE/maintenance ]; then
	log "maintenance mode: no frontend; SSH is up once Wi-Fi is"
	maintenance_screen
	basedos_network &
	# The menu on the boot screen (stock once, an update, disable BasedOS, uninstall, restart, power off).
	/usr/sbin/basedos-menu
	log "basedos-menu exited ($?); maintenance mode stays up"
	while :; do sleep 3600; done
fi

# How long did the last frontend run? Five short runs in a row stop the respawning.
if [ -f $STATE/session-start ]; then
	ran=$(( $(cut -d. -f1 /proc/uptime) - $(cat $STATE/session-start) ))
	short=$(cat $STATE/short-exits 2>/dev/null || echo 0)
	if [ "$ran" -lt 15 ]; then short=$((short + 1)); else short=0; fi
	echo "$short" > $STATE/short-exits
	log "frontend exited after ${ran} s (short exits in a row: $short)"
	[ "$short" -ge 5 ] &&
		stay_down "The frontend keeps closing. Restart to try again." "the frontend exited within 15 s 5 times in a row; not restarting it"
fi

# Quiet retries; one message per session, and only after 15 s without a card (at boot the card is
# usually a few tens of ms from being probed, so the first 2 s are polled every 50 ms). From then
# on the waiting screen stays up and the boot-key map is watched while the card is polled.
i=0
waiting=""
[ -f /run/basedos/said-nocard ] && waiting=1
until QUIET=1 /usr/sbin/mount-frontend 2>/dev/null; do
	i=$((i + 1))
	if [ -n "$waiting" ] || [ $i -ge 66 ]; then
		[ -f /run/basedos/said-nocard ] || { waiting_screen; touch /run/basedos/said-nocard; }
		waiting=1
		key_watch
		continue
	fi
	if [ $i -le 40 ]; then sleep 0.05; else sleep 0.5; fi
done
rm -f /run/basedos/said-nocard

# A system update, once a boot, now that the card is here (.bosupd at its root, as spruce's updater
# leaves them), only if the frontend asked for it (basedos-update request): install it and reboot
# into it. The request is used up first, so a failing update isn't retried at every boot. Only
# with /data on p2 (the update's record lives there).
if [ ! -f $STATE/updates-checked ]; then
	touch $STATE/updates-checked
	if [ -f $STATE/data-ok ]; then
		if [ -f /data/update/requested ]; then
			rm -f /data/update/requested; sync
			/usr/sbin/basedos-update apply
		else false; fi
		# 10: installed, and the reboot is under way (init stops this session).
		[ $? -eq 10 ] && while :; do sleep 3600; done
	fi
fi

cd "$SD" || exit 1
mark frontend
cut -d. -f1 /proc/uptime > $STATE/session-start
# A boot key's frontend first, when the card has it.
choice=$(cat $STATE/frontend-choice 2>/dev/null)
if [ -n "$choice" ]; then
	case "$choice" in
	/*|*..*) log "boot key frontend '$choice' must be a path inside the card; ignored" ;;
	*) [ -f "$choice" ] && run_frontend "$choice"
	   log "boot key frontend $choice isn't on the card; starting the usual one" ;;
	esac
fi
for entry in System/frontend System/launch_frontend.sh spruce/scripts/runtime.sh .tmp_update/updater; do
	[ -f "$entry" ] && run_frontend "$entry"
done
# None: a card that isn't a frontend's (a setup card, say). Wait, watching the boot keys, until
# one is there or the card is taken out (the next session waits for a card).
_hints=$(boot_key_hints maintenance stock)
{
	echo "!NO FRONTEND ON THE SD CARD"
	echo "Insert your spruce card."
	[ -n "$_hints" ] && echo "Or hold a labelled button."
	[ -n "$_hints" ] && echo "$_hints"
} > "$SPLASH_INFO"
say "Waiting for a card with a frontend..." "no frontend on the card (waiting for one)"
while :; do
	key_watch
	QUIET=1 /usr/sbin/mount-frontend 2>/dev/null || exit 1
	for entry in System/frontend System/launch_frontend.sh spruce/scripts/runtime.sh .tmp_update/updater; do
		[ -f "$SD/$entry" ] && exit 1
	done
done
