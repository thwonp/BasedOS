#!/bin/sh
# BasedOS system start (BusyBox init sysinit). Brings up the minimum, mounts the
# card, then frontend-session (respawned by init) takes over.
export PATH=/usr/bin:/usr/sbin
. /usr/lib/basedos/functions

mount -t proc proc /proc
mount -t sysfs sys /sys
mkdir -p /dev/pts /dev/shm
# Device nodes are the kernel's (devtmpfs, mounted by the initrd), with the kernel's modes;
# nothing rewrites them (BusyBox mdev without an mdev.conf made /dev/null root-only). Firmware is
# loaded by the kernel itself (no user helper), so no hotplug helper either.
mount -t devpts -o mode=620,ptmxmode=666 devpts /dev/pts
# The links a udev or systemd base makes and devtmpfs doesn't (bash's <(...), /dev/stdin readers).
ln -sf /proc/self/fd /dev/fd
ln -sf fd/0 /dev/stdin
ln -sf fd/1 /dev/stdout
ln -sf fd/2 /dev/stderr
mount -t tmpfs -o mode=1777 tmpfs /dev/shm
mount -t tmpfs -o mode=755,size=64m tmpfs /run
mount -t tmpfs -o mode=1777 tmpfs /tmp
mount -t tmpfs -o mode=755 tmpfs /var
mkdir -p /run/basedos /var/log /var/run /var/lib /var/empty /var/tmp
mark rcS-start

# The boot screen instead of console text: take the text console off the panel (kernel messages
# still reach the log; boot.scr also says loglevel=1 and hides the cursor), then draw BasedOS's.
for v in /sys/class/vtconsole/vtcon*; do
	grep -q "frame buffer" "$v/name" 2>/dev/null && echo 0 > "$v/bind" 2>/dev/null
done
splash_boot_info
# The bootloader's logo when there is one (boot_logo), drawn beside the boot rather than in its way.
if [ -f "$BOOT_LOGO" ]; then
	boot_logo &
	echo $! > /run/basedos/boot-logo.pid
else
	splash "Starting..."
fi

# /data: v0 lives in a folder on eMMC p2, next to stock's /storage, so stock
# still boots unchanged. (A dedicated p2 comes with the installer.) Checked first, as stock
# does every boot; e2fsck -p only fixes what is safe and is quick on a clean filesystem.
mkdir -p /run/p2
# The clock first: e2fsck compares the superblock's times with it, and a clock at 1970 would
# make it check the whole filesystem (or refuse, times "in the future").
hwclock -u -s 2>/dev/null || early_rtc=1
e2fsck -p $BOOT_P2 > /run/basedos/e2fsck.log 2>&1
fsck_rc=$?
data_ok=0
if [ $fsck_rc -lt 4 ] && mount -t ext4 -o noatime $BOOT_P2 /run/p2 &&
	mkdir -p /run/p2/basedos-data && mount --bind /run/p2/basedos-data /data; then
	data_ok=1
	touch /run/basedos/data-ok
	# Userspace is up: this boot counts as good (the initrd counts attempts that don't get here).
	rm -f /data/boot-attempts
	[ $fsck_rc -ne 0 ] && log "e2fsck repaired p2 (exit $fsck_rc): $(tail -1 /run/basedos/e2fsck.log)"
else
	mount -t tmpfs tmpfs /data
	# This boot still reached userspace: clear the initrd's count on p2 all the same (it writes
	# there itself every boot), or a p2 that needs a manual check would end in stock for good
	# from the 6th boot.
	if grep -q "^$BOOT_P2 /run/p2 " /proc/mounts || mount -t ext4 -o noatime $BOOT_P2 /run/p2 2>/dev/null; then
		rm -f /run/p2/basedos-data/boot-attempts
		sync
	fi
fi
# The log keeps about the last 256 KB: one older copy, replaced when the current one outgrows it.
[ -n "$(find /data/basedos.log -size +256k 2>/dev/null)" ] && mv /data/basedos.log /data/basedos.log.1
cat /run/basedos/early.log >> /data/basedos.log 2>/dev/null && rm -f /run/basedos/early.log
[ -n "${early_rtc:-}" ] && log "no RTC time"
log "boot $(cut -c1-8 /proc/sys/kernel/random/boot_id): BasedOS $BASEOS_VERSION ($BASEOS_BUILD)"
[ $data_ok = 1 ] || say "Settings can't be saved this boot." \
	"$BOOT_DISK p2 unusable (e2fsck exit $fsck_rc): /data is in RAM this boot; settings and logs won't persist"

# Accounts live on /data so a frontend can add its own (spruce's SSH/Samba user); the read-only
# root links /etc/passwd, group and shadow there. Seeded from the defaults on first boot.
mkdir -p /data/etc
for f in passwd group shadow; do
	[ -s /data/etc/$f ] || cp /usr/share/basedos/accounts/$f /data/etc/$f
done
chmod 600 /data/etc/shadow

hostname -F /etc/hostname
[ -f /data/machine-id ] || cat /proc/sys/kernel/random/uuid | tr -d - > /data/machine-id
ln -sf /data/machine-id /run/machine-id
ifconfig lo 127.0.0.1 up

# Card first: the frontend is what the user is waiting for. Often not probed yet this early;
# frontend-session keeps trying (and says so if it never comes), and settles and installs system
# updates (.bosupd at the card root) once the card is mounted, before the frontend starts.
QUIET=1 /usr/sbin/mount-frontend

# Everything slow goes to the background. Only the Wi-Fi driver: joining networks and SSH are
# the frontend's (spruce's), and BasedOS's own (network up, sshd) start in maintenance mode or
# when no frontend can run (frontend-session).
/etc/init.d/network &
/usr/sbin/basedos-shutdown-keys &
mark rcS-done
