# What BasedOS takes from its own Buildroot root (tools/buildroot/build.sh, buildroot/) into the
# system layer: the userland that used to come from stock (docs/vendor-minimal.md). Same format
# as harvest.list; the libraries these need are added automatically, and the build fails if one
# is missing. Everything here is built from source, so it ships in .bosupd updates.

## glibc (2.41): the loader, and the parts loaded with dlopen() or by name, which the closure
## can't see
/usr/lib/ld-linux-aarch64.so.1
/usr/lib/libc.so.6
/usr/lib/libm.so.6
/usr/lib/libmvec.so.1
/usr/lib/libdl.so.2
/usr/lib/libpthread.so.0
/usr/lib/librt.so.1
/usr/lib/libresolv.so.2
/usr/lib/libutil.so.1
/usr/lib/libanl.so.1
/usr/lib/libnss_files.so.2
/usr/lib/libnss_dns.so.2
/usr/lib/gconv
/usr/bin/getconf
# (no iconv command: Buildroot's glibc installs getconf and ldd only; the gconv modules that
# programs' iconv() needs are above)

## GCC 14's runtime: the closed Mali drivers, spruce's binaries, ports (OpenMP)
/usr/lib/libstdc++.so.6
/usr/lib/libgcc_s.so.1
/usr/lib/libgomp.so.1
/usr/lib/libatomic.so.1

## what the closed Mali drivers need (vendor layer)
/usr/lib/libwayland-client.so.0
/usr/lib/libwayland-server.so.0
/usr/lib/libdrm.so.2
# the unversioned name too: PortMaster's Weston pack finds libdrm by it (tools/findlib libdrm.so),
# and without it its Crusty layer assumes no DRM and Weston never starts
/usr/lib/libdrm.so
## the Khronos Vulkan loader (Mali's Vulkan driver is its ICD)
/usr/lib/libvulkan.so.1
# BasedOS's implicit layer (package basedos-vkrotate): VK_KHR_display apps (RetroArch's Vulkan driver)
# see the portrait panel as landscape, and their frames are turned onto it on present
/usr/lib/libVkLayer_basedos_rotate.so
/usr/share/vulkan/implicit_layer.d/VkLayer_basedos_rotate.json

## ssh (BasedOS's own, maintenance mode; keys live on /data)
/usr/sbin/sshd
/usr/bin/ssh-keygen
/usr/libexec/sshd-session
/usr/libexec/sftp-server

## wifi: the frontend runs its own wpa_supplicant; BasedOS's in maintenance mode
/usr/sbin/wpa_supplicant
/usr/sbin/wpa_cli
/usr/sbin/wpa_passphrase
/usr/sbin/iw

## filesystems: create and check /data (ext4), check the card (vfat, exfat)
/usr/sbin/mke2fs
/usr/sbin/mkfs.ext4
/usr/sbin/e2fsck
/usr/sbin/fsck.ext4
/usr/sbin/resize2fs
/usr/sbin/fsck.fat
/usr/sbin/fsck.vfat
/usr/sbin/fsck.exfat

## the vendor layer, built on the device from its own stock image (basedos-vendor): stock's
## SYSTEM is lz4, BasedOS's layers zstd
/usr/bin/mksquashfs
/usr/bin/unsquashfs

## audio and input
/usr/bin/amixer
/usr/bin/aplay
/usr/share/alsa
/usr/bin/evtest

## spruce's display_text.elf (message screens; USB Storage Mode runs it with the root's
## libraries only). Built against Buildroot's SDL2; BasedOS's own SDL2 is the one installed.
/usr/lib/libSDL2_image-2.0.so.0
/usr/lib/libSDL2_ttf-2.0.so.0

## what spruce's card binaries expect from the base (tools/needs-check.py, 2026-11-19)
/usr/lib/libssl.so.3
/usr/lib/libcrypto.so.3
/usr/lib/libdbus-1.so.3
/usr/lib/libexpat.so.1
/usr/lib/libfontconfig.so.1
/usr/lib/libfreetype.so.6
/usr/lib/libglib-2.0.so.0
/usr/lib/libncursesw.so.6
/usr/lib/libtinfo.so.6
/usr/lib/libsndfile.so.1
/usr/lib/libsqlite3.so.0
/usr/lib/libuuid.so.1
/usr/lib/libvorbisenc.so.2
/usr/lib/libz.so.1
/usr/lib/liblzma.so.5
# spruce's RetroArch (ra64.universal) links it; SDL builds load it with dlopen()
/usr/lib/libudev.so.1
# the unversioned name too: PortMaster's Weston pack (its Crusty layer) loads libudev by it, and
# without it Crusty's udev_new() resolves to itself and Weston spins forever
/usr/lib/libudev.so
## udev's daemon, for PortMaster's Weston ports only (2026-11-19). Weston won't start without input
## devices, and libinput finds them only through udev's database. Not run at boot:
## basedos-udev starts it for such a port and stops it after. Only the rule libinput needs
## (ID_INPUT*, from the input_id builtin); no module loading, no device permissions.
/usr/sbin/udevd
/usr/bin/udevadm
/usr/lib/udev/rules.d/60-input-id.rules
## and the sound cards', for basedos-pipewire (PipeWire's ALSA monitor reads udev's database; the
## rule also names USB DACs by vendor and model)
/usr/lib/udev/rules.d/78-sound-card.rules

## for PortMaster's ports (2026-11-19)
/usr/lib/libluajit-5.1.so.2
/usr/lib/libenet.so.7
/usr/lib/libjson-c.so.5
/usr/lib/libevdev.so.2
/usr/lib/libspeexdsp.so.1
/usr/lib/libusb-1.0.so.0
/usr/lib/libcurl.so.4
/usr/lib/libfluidsynth.so.3
# libxml2 waits for a port that needs it: Buildroot's is 2.15 (libxml2.so.16), and ports built
# against the old ABI look for libxml2.so.2.
/usr/lib/libharfbuzz.so.0
/usr/lib/libturbojpeg.so.0
/usr/lib/libtiff.so.6
/usr/bin/taskset
/usr/bin/stdbuf
/usr/libexec/coreutils/libstdbuf.so
/usr/bin/file
/usr/share/misc/magic.mgc
/usr/bin/zstd

## what PortMaster's ports load from the system that neither BasedOS nor spruce's card had
## (docs/portmaster-libs.md, all 1,511 ports scanned 2026-11-19): glib's object libraries (glib is
## here already). The rest of the ports' usual libraries (SDL2_mixer, OpenAL, ...) come from
## spruce's spruce/flip/lib, which spruce puts on every port's library path.
/usr/lib/libgobject-2.0.so.0
/usr/lib/libgmodule-2.0.so.0
/usr/lib/libgio-2.0.so.0
# and what spruce's spruce/flip/lib needs from the base that it doesn't carry (tools/dev/lib-closure.py
# on the device): libbsd (+ libmd) for its libXdmcp and libICE, on the PulseAudio client chain that
# ports' bundled libmikmod and libfluidsynth load; libtheora's encoder for its FFmpeg 4.
/usr/lib/libbsd.so.0
/usr/lib/libtheoraenc.so.1
# FLAC 1.3's library (libFLAC.so.8, BasedOS's flac13 package, beside FLAC 1.4's .so.12): the old ABI
# that 13 ports link, A7Xpg's SDL_mixer among them.
/usr/lib/libFLAC.so.8
# OpenAL Soft (as /usr/lib32 has it): spruce's flip/lib has one too, but ports on PortMaster's Weston
# pack don't see flip/lib (westonwrap.sh sets its own library path), so for them it must be the
# system's. build-rootfs.sh adds the unversioned libopenal.so that LWJGL 2 looks for.
/usr/lib/libopenal.so.1

## sound server and Bluetooth, for frontends that want them (plorpOS; nothing starts them at boot):
## PipeWire with its PulseAudio server and ALSA plugin (pcm.pipewire; ALSA's default is left
## alone, a frontend points it at PipeWire in its own .asoundrc), WirePlumber, pactl, D-Bus's
## system bus, bluez5 and the HCI attach tools. Their plugins and configs are loaded by name.
/usr/bin/pipewire
/usr/bin/pipewire-pulse
/usr/bin/wireplumber
/usr/bin/wpctl
/usr/bin/pw-cli
/usr/bin/pw-dump
/usr/bin/pw-cat
/usr/bin/pw-play
/usr/bin/pactl
/usr/lib/pipewire-0.3
/usr/lib/spa-0.2
/usr/lib/wireplumber-0.5
/usr/lib/alsa-lib
/usr/share/pipewire
/usr/share/wireplumber
/usr/share/alsa-card-profile
/usr/bin/dbus-daemon
/usr/bin/dbus-send
/usr/libexec/dbus-daemon-launch-helper
/usr/share/dbus-1
/etc/dbus-1
/usr/libexec/bluetooth
/usr/bin/bluetoothctl
/usr/bin/btattach
/usr/bin/hciattach
/usr/bin/hciconfig
/etc/bluetooth
